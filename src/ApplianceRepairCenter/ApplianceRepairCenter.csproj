<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ApplianceRepairCenter</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Lets the program run on a newer .NET runtime when .NET 8 itself is not installed. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- The unit tests also exercise the console user interface, whose classes are internal. -->
    <InternalsVisibleTo Include="ApplianceRepairCenter.Tests" />
  </ItemGroup>

</Project>
